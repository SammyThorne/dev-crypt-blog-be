[Unit]
Description=Blog Go Backend Service
After=network.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/root/blog/backend
ExecStart=/root/blog/backend/server
EnvironmentFile=-/root/blog/backend/.env
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
